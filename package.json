{
  "name": "giratempo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/site-privacy-check.js && node scripts/game-kit-check.js && tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:kit": "node scripts/game-kit-check.js",
    "test:kit": "node --test scripts/game-kit-test.js",
    "test:kit:browser": "node scripts/game-kit-browser-test.js",
    "test:experiment": "node --test scripts/solid-three-test.js",
    "test:experiment:browser": "node scripts/solid-three-browser-test.js",
    "benchmark:experiment": "node scripts/solid-three-benchmark.js",
    "check:privacy": "node scripts/site-privacy-check.js"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@solidjs/web": "2.0.0-rc.16",
    "@vercel/analytics": "^1.6.1",
    "autoprefixer": "^10.4.18",
    "lucide-react": "^0.463.0",
    "postcss": "^8.4.35",
    "react": "18.3.1",
    "react-confetti": "^6.2.1",
    "react-dom": "18.3.1",
    "solid-js": "2.0.0-rc.16",
    "tailwindcss": "^3.4.1",
    "three": "0.186.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@solidjs/babel-plugin": "2.0.0-rc.16",
    "@types/babel__core": "7.20.5",
    "@types/node": "^20.11.24",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4"
  }
}
